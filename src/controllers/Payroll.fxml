<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox fx:id="rootPane"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.buildpay.controller.PayrollController"
      prefWidth="1320" prefHeight="820"
      styleClass="payroll-root"
      stylesheets="@../css/payroll.css"
      spacing="20">

    <padding>
        <Insets top="28" right="32" bottom="24" left="32" />
    </padding>

    <!-- ================= TOOLBAR ================= -->
    <HBox fx:id="toolbar" styleClass="toolbar" alignment="CENTER_LEFT" spacing="14">
        <Button fx:id="backButton" text="&#8592;" styleClass="back-button" onAction="#handleBack" />
        <VBox spacing="4">
            <Label text="Payroll Processing" styleClass="page-title" />
            <Label text="Compute, generate and approve monthly payroll" styleClass="page-subtitle" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <ComboBox fx:id="periodSelector" styleClass="filter-combo" prefWidth="150" />
        <Button fx:id="exportButton" text="Export" styleClass="secondary-button" onAction="#handleExport" />
        <Button fx:id="printButton" text="Print" styleClass="secondary-button" onAction="#handlePrint" />
        <Button fx:id="approveButton" text="Approve Payroll" styleClass="secondary-button-accent" onAction="#handleApprovePayroll" />
    </HBox>

    <!-- ================= MAIN SPLIT ================= -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <!-- ---- LEFT: SALARY CALCULATOR (enterprise card) ---- -->
        <ScrollPane fx:id="calculatorScroll" styleClass="calculator-scroll" fitToWidth="true"
                    prefWidth="400" minWidth="400" maxWidth="400">
            <VBox fx:id="calculatorCard" styleClass="enterprise-card" spacing="16">

                <VBox spacing="2">
                    <Label text="Salary Calculator" styleClass="card-title" />
                    <Label text="Live payroll computation" styleClass="card-subtitle" />
                </VBox>

                <VBox spacing="6">
                    <Label text="Employee" styleClass="form-field-label" />
                    <ComboBox fx:id="employeeSelector" styleClass="form-combo" maxWidth="Infinity"
                              promptText="Select an employee" />
                </VBox>

                <HBox alignment="CENTER_LEFT" styleClass="basic-salary-row">
                    <Label text="Basic Salary" styleClass="basic-salary-label" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="basicSalaryValueLabel" text="KES 0" styleClass="basic-salary-value" />
                </HBox>

                <Separator />
                <Label text="ALLOWANCES" styleClass="section-header" />

                <HBox spacing="10">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Housing" styleClass="form-field-label" />
                        <TextField fx:id="housingField" text="0" styleClass="form-field" />
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Transport" styleClass="form-field-label" />
                        <TextField fx:id="transportField" text="0" styleClass="form-field" />
                    </VBox>
                </HBox>

                <HBox spacing="10">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Overtime" styleClass="form-field-label" />
                        <TextField fx:id="overtimeField" text="0" styleClass="form-field" />
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Bonuses" styleClass="form-field-label" />
                        <TextField fx:id="bonusesField" text="0" styleClass="form-field" />
                    </VBox>
                </HBox>

                <VBox spacing="6">
                    <Label text="Other Allowances" styleClass="form-field-label" />
                    <TextField fx:id="allowancesField" text="0" styleClass="form-field" />
                </VBox>

                <Separator />
                <Label text="DEDUCTIONS" styleClass="section-header" />

                <VBox spacing="6">
                    <Label text="Other Deductions" styleClass="form-field-label" />
                    <TextField fx:id="deductionsField" text="0" styleClass="form-field" />
                </VBox>

                <HBox alignment="CENTER_LEFT" styleClass="computed-row">
                    <Label text="NSSF (statutory)" styleClass="computed-label" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="nssfValueLabel" text="KES 0" styleClass="computed-value" />
                </HBox>
                <HBox alignment="CENTER_LEFT" styleClass="computed-row">
                    <Label text="PAYE (statutory)" styleClass="computed-label" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="payeValueLabel" text="KES 0" styleClass="computed-value" />
                </HBox>

                <Separator />

                <VBox styleClass="summary-block" spacing="10">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Gross Pay" styleClass="summary-label" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="grossPayLabel" text="KES 0" styleClass="summary-value" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Total Deductions" styleClass="summary-label" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="totalDeductionsLabel" text="KES 0" styleClass="summary-value" />
                    </HBox>
                    <Separator />
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Net Pay" styleClass="summary-label-net" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="netPayLabel" text="KES 0" styleClass="summary-value-net" />
                    </HBox>
                </VBox>

                <Button fx:id="generatePayrollButton" text="Generate Payroll" styleClass="generate-btn"
                        maxWidth="Infinity" onAction="#handleGeneratePayroll" />

            </VBox>
        </ScrollPane>

        <!-- ---- RIGHT: PAYROLL TABLE ---- -->
        <VBox styleClass="enterprise-card" spacing="0" HBox.hgrow="ALWAYS">

            <HBox alignment="CENTER_LEFT" styleClass="table-card-header" spacing="12">
                <VBox spacing="2">
                    <Label fx:id="tableHeaderLabel" text="Payroll" styleClass="card-title" />
                    <Label fx:id="recordCountLabel" text="0 records" styleClass="card-subtitle" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <StackPane styleClass="search-box" alignment="CENTER_LEFT">
                    <Text text="&#128269;" styleClass="search-icon" StackPane.alignment="CENTER_LEFT" />
                    <TextField fx:id="searchField" promptText="Search by name or employee ID..."
                               styleClass="search-field" prefWidth="220" />
                </StackPane>
                <ComboBox fx:id="statusFilter" styleClass="filter-combo" prefWidth="150" />
            </HBox>

            <TableView fx:id="payrollTable" styleClass="payroll-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" text="Employee ID" prefWidth="95" />
                    <TableColumn fx:id="nameColumn" text="Name" prefWidth="150" />
                    <TableColumn fx:id="departmentColumn" text="Department" prefWidth="130" />
                    <TableColumn fx:id="basicColumn" text="Basic" prefWidth="95" />
                    <TableColumn fx:id="grossColumn" text="Gross Pay" prefWidth="105" />
                    <TableColumn fx:id="nssfColumn" text="NSSF" prefWidth="85" />
                    <TableColumn fx:id="payeColumn" text="PAYE" prefWidth="90" />
                    <TableColumn fx:id="netColumn" text="Net Pay" prefWidth="105" />
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="120" sortable="false" />
                    <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="130" sortable="false" />
                </columns>
            </TableView>

            <HBox fx:id="paginationBar" styleClass="pagination-bar" alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="paginationSummaryLabel" text="Showing 0 of 0" styleClass="pagination-summary" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="prevPageButton" text="&#8592; Prev" styleClass="pagination-nav-btn" onAction="#handlePrevPage" />
                <HBox fx:id="pageNumbersBox" spacing="6" alignment="CENTER" />
                <Button fx:id="nextPageButton" text="Next &#8594;" styleClass="pagination-nav-btn" onAction="#handleNextPage" />
            </HBox>
        </VBox>

    </HBox>

</VBox>
