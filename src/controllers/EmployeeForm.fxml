<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Text?>

<StackPane fx:id="formRoot"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.buildpay.controller.EmployeeFormController"
           styleClass="form-root"
           stylesheets="@../css/employee.css">

    <VBox styleClass="form-card" spacing="18" maxWidth="440" minWidth="440">
        <padding>
            <Insets top="26" right="30" bottom="26" left="30" />
        </padding>

        <HBox alignment="CENTER_LEFT">
            <Label fx:id="formTitleLabel" text="Add Employee" styleClass="form-title" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="closeIconButton" text="&#10005;" styleClass="form-close-btn" onAction="#handleCancel" />
        </HBox>

        <StackPane alignment="CENTER" maxHeight="72">
            <Circle fx:id="avatarCircle" radius="34" styleClass="form-avatar-circle" />
            <Text fx:id="avatarInitialsText" text="EM" styleClass="form-avatar-text" />
        </StackPane>

        <VBox spacing="6">
            <Label text="Full Name" styleClass="form-field-label" />
            <TextField fx:id="nameField" promptText="e.g. James Otieno" styleClass="form-field" />
            <Label fx:id="nameErrorLabel" styleClass="form-error-label" managed="false" visible="false"
                   text="Name is required" />
        </VBox>

        <HBox spacing="14">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Employee ID" styleClass="form-field-label" />
                <TextField fx:id="idField" promptText="Auto-generated" styleClass="form-field" editable="false" />
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Department" styleClass="form-field-label" />
                <ComboBox fx:id="departmentField" styleClass="form-combo" maxWidth="Infinity" />
            </VBox>
        </HBox>

        <VBox spacing="6">
            <Label text="Position" styleClass="form-field-label" />
            <TextField fx:id="positionField" promptText="e.g. Site Supervisor" styleClass="form-field" />
            <Label fx:id="positionErrorLabel" styleClass="form-error-label" managed="false" visible="false"
                   text="Position is required" />
        </VBox>

        <HBox spacing="14">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Phone" styleClass="form-field-label" />
                <TextField fx:id="phoneField" promptText="07XX XXX XXX" styleClass="form-field" />
                <Label fx:id="phoneErrorLabel" styleClass="form-error-label" managed="false" visible="false"
                       text="Enter a valid phone number" />
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Salary (KES)" styleClass="form-field-label" />
                <TextField fx:id="salaryField" promptText="e.g. 45000" styleClass="form-field" />
                <Label fx:id="salaryErrorLabel" styleClass="form-error-label" managed="false" visible="false"
                       text="Enter a valid amount" />
            </VBox>
        </HBox>

        <VBox spacing="6">
            <Label text="Status" styleClass="form-field-label" />
            <ComboBox fx:id="statusField" styleClass="form-combo" maxWidth="Infinity" />
        </VBox>

        <HBox spacing="12" alignment="CENTER_RIGHT">
            <Button fx:id="cancelButton" text="Cancel" styleClass="form-cancel-btn" onAction="#handleCancel" />
            <Button fx:id="saveButton" text="Save Employee" styleClass="form-save-btn" onAction="#handleSave"
                    defaultButton="true" />
        </HBox>

    </VBox>
</StackPane>
