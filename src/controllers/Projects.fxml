<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox fx:id="rootPane"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.buildpay.controller.ProjectsController"
      prefWidth="1280" prefHeight="820"
      styleClass="projects-root"
      stylesheets="@../css/projects.css"
      spacing="20">

    <padding>
        <Insets top="28" right="32" bottom="24" left="32" />
    </padding>

    <!-- ================= TOOLBAR ================= -->
    <HBox fx:id="toolbar" styleClass="toolbar" alignment="CENTER_LEFT" spacing="14">
        <Button fx:id="backButton" text="&#8592;" styleClass="back-button" onAction="#handleBack" />
        <VBox spacing="4">
            <Label text="Projects Management" styleClass="page-title" />
            <Label fx:id="pageSubtitleLabel" text="Track progress, budgets and crews across every site" styleClass="page-subtitle" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <StackPane styleClass="search-box" alignment="CENTER_LEFT">
            <Text text="&#128269;" styleClass="search-icon" StackPane.alignment="CENTER_LEFT" />
            <TextField fx:id="searchField" promptText="Search projects..." styleClass="search-field" prefWidth="220" />
        </StackPane>
        <ComboBox fx:id="statusFilter" styleClass="filter-combo" prefWidth="150" />
    </HBox>

    <!-- ================= PROJECT CARD GRID ================= -->
    <ScrollPane fx:id="cardsScroll" styleClass="cards-scroll" fitToWidth="true" VBox.vgrow="ALWAYS">
        <FlowPane fx:id="projectsFlowPane" styleClass="cards-flow" hgap="20" vgap="20" />
    </ScrollPane>

    <!-- ================= PAGINATION ================= -->
    <HBox fx:id="paginationBar" styleClass="pagination-bar" alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="paginationSummaryLabel" text="Showing 0 of 0" styleClass="pagination-summary" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="prevPageButton" text="&#8592; Prev" styleClass="pagination-nav-btn" onAction="#handlePrevPage" />
        <HBox fx:id="pageNumbersBox" spacing="6" alignment="CENTER" />
        <Button fx:id="nextPageButton" text="Next &#8594;" styleClass="pagination-nav-btn" onAction="#handleNextPage" />
    </HBox>

</VBox>
