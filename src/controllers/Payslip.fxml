<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Text?>

<VBox fx:id="rootPane"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.buildpay.controller.PayslipController"
      prefWidth="1100" prefHeight="820"
      styleClass="payslip-root"
      stylesheets="@../css/payslip.css"
      spacing="20">

    <padding>
        <Insets top="28" right="32" bottom="24" left="32" />
    </padding>

    <!-- ================= HEADER ================= -->
    <HBox fx:id="toolbar" styleClass="toolbar" alignment="CENTER_LEFT" spacing="14">
        <Button fx:id="backButton" text="&#8592;" styleClass="back-button" onAction="#handleBack" />
        <VBox spacing="4">
            <Label text="Payslip Viewer" styleClass="page-title" />
            <Label text="View, download and print employee payslips" styleClass="page-subtitle" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <ComboBox fx:id="employeeSelector" styleClass="filter-combo" prefWidth="200" />
        <ComboBox fx:id="periodSelector" styleClass="filter-combo" prefWidth="150" />
        <Button fx:id="downloadPdfButton" text="Download PDF" styleClass="secondary-button-accent"
                onAction="#handleDownloadPdf" />
        <Button fx:id="printButton" text="Print" styleClass="secondary-button" onAction="#handlePrint" />
    </HBox>

    <!-- ================= RESPONSIVE PAYSLIP CARD ================= -->
    <ScrollPane fx:id="cardScroll" styleClass="card-scroll" fitToWidth="true" VBox.vgrow="ALWAYS">
        <StackPane alignment="TOP_CENTER" styleClass="card-stage">
            <VBox fx:id="payslipCard" styleClass="payslip-card" maxWidth="720" minWidth="480" spacing="20">

                <!-- ---- Company logo + payslip meta ---- -->
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <StackPane maxWidth="52" maxHeight="52">
                        <Circle radius="26" styleClass="brand-glow" />
                        <Rectangle width="44" height="44" arcWidth="14" arcHeight="14" styleClass="brand-badge" />
                        <Text text="BP" styleClass="brand-text" />
                    </StackPane>
                    <VBox spacing="2">
                        <Label text="BuildPay" styleClass="brand-name" />
                        <Label text="Construction Payroll System" styleClass="brand-tagline" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <VBox alignment="TOP_RIGHT" spacing="2">
                        <Label text="PAYSLIP" styleClass="payslip-tag" />
                        <Label fx:id="periodValueLabel" text="July 2026" styleClass="payslip-period" />
                    </VBox>
                </HBox>

                <Separator />

                <!-- ---- Employee details ---- -->
                <HBox spacing="30">
                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                        <HBox spacing="8"><Label text="Employee Name" styleClass="detail-label" />
                            <Region HBox.hgrow="ALWAYS" /><Label fx:id="employeeNameLabel" text="&#8212;" styleClass="detail-value" /></HBox>
                        <HBox spacing="8"><Label text="Employee ID" styleClass="detail-label" />
                            <Region HBox.hgrow="ALWAYS" /><Label fx:id="employeeIdLabel" text="&#8212;" styleClass="detail-value" /></HBox>
                        <HBox spacing="8"><Label text="Department" styleClass="detail-label" />
                            <Region HBox.hgrow="ALWAYS" /><Label fx:id="departmentLabel" text="&#8212;" styleClass="detail-value" /></HBox>
                    </VBox>
                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                        <HBox spacing="8"><Label text="Position" styleClass="detail-label" />
                            <Region HBox.hgrow="ALWAYS" /><Label fx:id="positionLabel" text="&#8212;" styleClass="detail-value" /></HBox>
                        <HBox spacing="8"><Label text="Pay Period" styleClass="detail-label" />
                            <Region HBox.hgrow="ALWAYS" /><Label fx:id="payPeriodLabel" text="&#8212;" styleClass="detail-value" /></HBox>
                        <HBox spacing="8"><Label text="Pay Date" styleClass="detail-label" />
                            <Region HBox.hgrow="ALWAYS" /><Label fx:id="payDateLabel" text="&#8212;" styleClass="detail-value" /></HBox>
                    </VBox>
                </HBox>

                <Separator />

                <!-- ---- Earnings ---- -->
                <VBox spacing="10">
                    <Label text="EARNINGS" styleClass="section-header" />
                    <HBox spacing="8"><Label text="Basic Salary" styleClass="line-label" />
                        <Region HBox.hgrow="ALWAYS" /><Label fx:id="basicValueLabel" text="KES 0" styleClass="line-value" /></HBox>
                    <HBox spacing="8"><Label text="Housing Allowance" styleClass="line-label" />
                        <Region HBox.hgrow="ALWAYS" /><Label fx:id="housingValueLabel" text="KES 0" styleClass="line-value" /></HBox>
                    <HBox spacing="8"><Label text="Transport Allowance" styleClass="line-label" />
                        <Region HBox.hgrow="ALWAYS" /><Label fx:id="transportValueLabel" text="KES 0" styleClass="line-value" /></HBox>
                    <HBox spacing="8"><Label text="Overtime" styleClass="line-label" />
                        <Region HBox.hgrow="ALWAYS" /><Label fx:id="overtimeValueLabel" text="KES 0" styleClass="line-value" /></HBox>
                    <HBox spacing="8"><Label text="Bonuses" styleClass="line-label" />
                        <Region HBox.hgrow="ALWAYS" /><Label fx:id="bonusesValueLabel" text="KES 0" styleClass="line-value" /></HBox>
                    <HBox spacing="8"><Label text="Other Allowances" styleClass="line-label" />
                        <Region HBox.hgrow="ALWAYS" /><Label fx:id="otherAllowancesValueLabel" text="KES 0" styleClass="line-value" /></HBox>
                    <HBox alignment="CENTER_LEFT" styleClass="subtotal-row" spacing="8">
                        <Label text="Gross Pay" styleClass="subtotal-label" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="grossPayValueLabel" text="KES 0" styleClass="subtotal-value" />
                    </HBox>
                </VBox>

                <Separator />

                <!-- ---- Deductions ---- -->
                <VBox spacing="10">
                    <Label text="DEDUCTIONS" styleClass="section-header" />
                    <HBox spacing="8"><Label text="NSSF" styleClass="line-label" />
                        <Region HBox.hgrow="ALWAYS" /><Label fx:id="nssfValueLabel" text="KES 0" styleClass="line-value-negative" /></HBox>
                    <HBox spacing="8"><Label text="PAYE" styleClass="line-label" />
                        <Region HBox.hgrow="ALWAYS" /><Label fx:id="payeValueLabel" text="KES 0" styleClass="line-value-negative" /></HBox>
                    <HBox spacing="8"><Label text="Other Deductions" styleClass="line-label" />
                        <Region HBox.hgrow="ALWAYS" /><Label fx:id="otherDeductionsValueLabel" text="KES 0" styleClass="line-value-negative" /></HBox>
                    <HBox alignment="CENTER_LEFT" styleClass="subtotal-row" spacing="8">
                        <Label text="Total Deductions" styleClass="subtotal-label" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="totalDeductionsValueLabel" text="KES 0" styleClass="subtotal-value-negative" />
                    </HBox>
                </VBox>

                <!-- ---- Net Salary ---- -->
                <HBox alignment="CENTER_LEFT" styleClass="net-salary-band" spacing="8">
                    <Label text="NET SALARY" styleClass="net-salary-label" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="netSalaryValueLabel" text="KES 0" styleClass="net-salary-value" />
                </HBox>

                <Separator />

                <!-- ---- Signature ---- -->
                <HBox spacing="40">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Region styleClass="signature-line" />
                        <Label text="Employee Signature" styleClass="signature-label" />
                        <Label fx:id="employeeSignatureDateLabel" text="Date: __________________" styleClass="signature-date" />
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Region styleClass="signature-line" />
                        <Label text="Authorized Signature" styleClass="signature-label" />
                        <Label fx:id="authSignatureDateLabel" text="Date: __________________" styleClass="signature-date" />
                    </VBox>
                </HBox>

                <Separator />

                <!-- ---- Footer ---- -->
                <VBox spacing="4" alignment="CENTER">
                    <Label text="This is a system-generated payslip and does not require a physical stamp."
                           styleClass="footer-note" wrapText="true" />
                    <Label fx:id="generatedTimestampLabel" text="Generated on --" styleClass="footer-meta" />
                </VBox>

            </VBox>
        </StackPane>
    </ScrollPane>

</VBox>
