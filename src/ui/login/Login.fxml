<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.payroll.controllers.LoginController"
        stylesheets="@login.css"
        styleClass="app-root">
    <StackPane AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" alignment="CENTER">
        <HBox fx:id="loginCard" spacing="0" alignment="CENTER" styleClass="login-card">
            <StackPane fx:id="leftPanel" HBox.hgrow="ALWAYS" styleClass="left-panel">
                <ImageView fx:id="bgImage" fitWidth="560" fitHeight="720" preserveRatio="false" styleClass="bg-image">
                    <image>
                        <Image url="@images/login_background_photo.png" />
                    </image>
                </ImageView>
                <Region styleClass="overlay" />
                <VBox alignment="CENTER" spacing="20" styleClass="branding">
                    <ImageView fitWidth="80" fitHeight="80" preserveRatio="true" styleClass="logo">
                        <image>
                            <Image url="@images/logo.png" />
                        </image>
                    </ImageView>
                    <HBox alignment="CENTER" spacing="8">
                        <Label text="BUILD" styleClass="brand-text build" />
                        <Label text="PAY" styleClass="brand-text pay" />
                    </HBox>
                    <Label text="CONSTRUCTION PAYROLL SYSTEM" styleClass="brand-subtitle" />
                    <Label text="Manage your construction workforce, attendance, payroll and reports efficiently in one place." wrapText="true" styleClass="brand-desc" />
                    <HBox alignment="CENTER" spacing="25" styleClass="badges">
                        <VBox alignment="CENTER" spacing="8">
                            <StackPane styleClass="badge-icon workforce" prefWidth="50" prefHeight="50" />
                            <Label text="Workforce" styleClass="badge-text" />
                            <Label text="Management" styleClass="badge-text" />
                        </VBox>
                        <VBox alignment="CENTER" spacing="8">
                            <StackPane styleClass="badge-icon attendance" prefWidth="50" prefHeight="50" />
                            <Label text="Attendance" styleClass="badge-text" />
                            <Label text="Tracking" styleClass="badge-text" />
                        </VBox>
                        <VBox alignment="CENTER" spacing="8">
                            <StackPane styleClass="badge-icon payroll" prefWidth="50" prefHeight="50" />
                            <Label text="Payroll" styleClass="badge-text" />
                            <Label text="Processing" styleClass="badge-text" />
                        </VBox>
                        <VBox alignment="CENTER" spacing="8">
                            <StackPane styleClass="badge-icon reports" prefWidth="50" prefHeight="50" />
                            <Label text="Reports &amp;" styleClass="badge-text" />
                            <Label text="Analytics" styleClass="badge-text" />
                        </VBox>
                    </HBox>
                </VBox>
            </StackPane>
            <VBox fx:id="rightPanel" HBox.hgrow="ALWAYS" spacing="14" alignment="TOP_CENTER" styleClass="right-panel">
                <Region prefHeight="40" />
                <Label text="Welcome Back!" styleClass="title" />
                <Label text="Sign in to continue to your account" styleClass="subtitle" />
                <VBox spacing="4" styleClass="field-group">
                    <Label text="Username" styleClass="field-label" />
                    <StackPane styleClass="input-box">
                        <TextField fx:id="usernameField" promptText="Enter your username" styleClass="input-field" />
                        <Region styleClass="input-icon user-icon" StackPane.alignment="CENTER_LEFT">
                            <StackPane.margin>
                                <Insets left="16" />
                            </StackPane.margin>
                        </Region>
                    </StackPane>
                </VBox>
                <VBox spacing="4" styleClass="field-group">
                    <Label text="Password" styleClass="field-label" />
                    <StackPane styleClass="input-box">
                        <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="input-field" />
                        <TextField fx:id="passwordVisibleField" promptText="Enter your password" styleClass="input-field" visible="false" managed="false" />
                        <Region styleClass="input-icon lock-icon" StackPane.alignment="CENTER_LEFT">
                            <StackPane.margin>
                                <Insets left="16" />
                            </StackPane.margin>
                        </Region>
                        <Region fx:id="eyeIcon" styleClass="input-icon eye-icon" StackPane.alignment="CENTER_RIGHT"
                                onMousePressed="#showPasswordPressed" onMouseReleased="#showPasswordReleased">
                            <StackPane.margin>
                                <Insets right="16" />
                            </StackPane.margin>
                        </Region>
                    </StackPane>
                </VBox>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <CheckBox text="Remember me" styleClass="checkbox" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Hyperlink text="Forgot password?" styleClass="link" />
                </HBox>
                <Button fx:id="signInBtn" text="Sign In" onAction="#login" styleClass="btn-primary" />
                <HBox alignment="CENTER" spacing="12" styleClass="divider">
                    <Separator HBox.hgrow="ALWAYS" />
                    <Label text="OR" styleClass="divider-text" />
                    <Separator HBox.hgrow="ALWAYS" />
                </HBox>
                <Button text="Login as Admin" styleClass="btn-secondary" />
                <Region VBox.vgrow="ALWAYS" />
                <Label text="© 2025 BuildPay. All rights reserved." styleClass="footer" />
                <Label fx:id="messageLabel" styleClass="message" />
            </VBox>
        </HBox>
    </StackPane>
</AnchorPane>
