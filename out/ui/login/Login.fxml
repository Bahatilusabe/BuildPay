<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.payroll.controllers.LoginController"
            stylesheets="@login.css"
            styleClass="app-root">

    <!-- Center the fixed-size login container -->
    <StackPane AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" alignment="CENTER">

        <StackPane fx:id="loginContainer" prefWidth="1120" prefHeight="720" styleClass="login-container" alignment="CENTER">

            <HBox spacing="0" styleClass="login-split" maxWidth="1120" maxHeight="720">

                <!-- LEFT BRANDING PANEL -->
                <StackPane prefWidth="540" prefHeight="720" styleClass="left-panel">

                    <!-- Construction background image -->
                    <ImageView fitWidth="540" fitHeight="720" preserveRatio="false" pickOnBounds="false" styleClass="bg-image">
                        <image>
                            <Image url="@images/login_background_photo.png" />
                        </image>
                    </ImageView>

                    <!-- Dark overlay to leave only silhouettes visible -->
                    <Region styleClass="bg-overlay" />

                    <!-- Branding content over the overlay -->
                    <VBox alignment="TOP_CENTER" spacing="12" styleClass="branding-content">
                        <VBox prefHeight="60" />
                        <ImageView fitWidth="140" fitHeight="140" preserveRatio="true" styleClass="logo-image">
                            <image>
                                <Image url="@images/logo.png" />
                            </image>
                        </ImageView>

                        <HBox alignment="CENTER" spacing="6">
                            <Label text="BUILD" styleClass="brand-title" />
                            <Label text="PAY" styleClass="brand-title-pay" />
                        </HBox>
                        <Label text="CONSTRUCTION PAYROLL SYSTEM" styleClass="brand-subtitle" />

                        <Label text="Manage your construction workforce, attendance, payroll and reports efficiently in one place." wrapText="true" styleClass="brand-description" />

                        <Region prefHeight="40" />

                        <!-- badges removed per request -->

                    </VBox>

                </StackPane>

                <!-- RIGHT LOGIN PANEL -->
                <VBox prefWidth="580" alignment="TOP_CENTER" spacing="12" styleClass="right-panel">

                    <Region prefHeight="80" />

                    <Label text="Welcome Back!" styleClass="welcome-title" />
                    <Label text="Sign in to continue to your account" styleClass="welcome-subtitle" />

                    <!-- Username -->
                    <VBox spacing="10" styleClass="field-block">
                        <Label text="Username" styleClass="field-label" />
                        <StackPane prefWidth="450" prefHeight="58" styleClass="input-wrap">
                            <TextField fx:id="usernameField" promptText="Enter your username" styleClass="input-field" />
                        </StackPane>
                    </VBox>

                    <!-- Password -->
                    <VBox spacing="10" styleClass="field-block">
                        <Label text="Password" styleClass="field-label" />
                        <StackPane prefWidth="450" prefHeight="58" styleClass="input-wrap">
                            <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="input-field" />
                        </StackPane>
                    </VBox>

                    <HBox prefWidth="450" alignment="CENTER_LEFT">
                        <CheckBox text="Remember Me" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Hyperlink text="Forgot password?" styleClass="forgot-link" />
                    </HBox>

                    <Button text="Sign In" fx:id="loginButton" onAction="#login" prefWidth="450" prefHeight="58" styleClass="primary-btn" />

                    <!-- OR divider -->
                    <HBox alignment="CENTER" spacing="12" styleClass="or-divider" prefWidth="450">
                        <Separator HBox.hgrow="ALWAYS" />
                        <Label text="OR" styleClass="or-text" />
                        <Separator HBox.hgrow="ALWAYS" />
                    </HBox>

                    <Button text="Login as Admin" prefWidth="450" prefHeight="58" styleClass="admin-btn" />

                    <Region prefHeight="18" />
                    <Label text="© 2025 BuildPay. All rights reserved." styleClass="footer-text" />

                    <Label fx:id="messageLabel" />

                </VBox>

        </HBox>

    </StackPane>

    </StackPane>

</AnchorPane>
