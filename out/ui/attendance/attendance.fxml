<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.buildpay.controller.AttendanceViewController"
            prefWidth="1200" prefHeight="800" stylesheets="@attendance.css">

    <center>
        <VBox spacing="16" styleClass="main-content">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <HBox alignment="CENTER_LEFT">
                <VBox>
                    <Label text="Attendance Management" styleClass="page-title"/>
                    <Label text="Track field attendance and generate reports" styleClass="muted"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="8" alignment="CENTER">
                    <DatePicker fx:id="datePicker"/>
                    <ComboBox fx:id="employeeSelector" promptText="Employee"/>
                    <ComboBox fx:id="projectSelector" promptText="Project"/>
                    <Button text="Mark Attendance" styleClass="add-employee-btn" onAction="#handleMarkAttendance"/>
                </HBox>
            </HBox>

            <!-- KPI Cards -->
            <HBox spacing="12">
                <VBox styleClass="stat-card" prefWidth="220" alignment="CENTER_LEFT" spacing="6">
                    <Label text="Present Today" styleClass="stat-label"/>
                    <Label fx:id="lblPresent" text="128" styleClass="stat-value"/>
                </VBox>
                <VBox styleClass="stat-card" prefWidth="220" alignment="CENTER_LEFT" spacing="6">
                    <Label text="Absent Today" styleClass="stat-label"/>
                    <Label fx:id="lblAbsent" text="12" styleClass="stat-value"/>
                </VBox>
                <VBox styleClass="stat-card" prefWidth="220" alignment="CENTER_LEFT" spacing="6">
                    <Label text="Late Arrivals" styleClass="stat-label"/>
                    <Label fx:id="lblLate" text="6" styleClass="stat-value"/>
                </VBox>
                <VBox styleClass="stat-card" prefWidth="220" alignment="CENTER_LEFT" spacing="6">
                    <Label text="Overtime Workers" styleClass="stat-label"/>
                    <Label fx:id="lblOvertime" text="4" styleClass="stat-value"/>
                </VBox>
            </HBox>

            <HBox spacing="12">
                <VBox spacing="8" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
                    <Label text="Attendance Trend" styleClass="chart-title"/>
                    <LineChart fx:id="attendanceChart" prefHeight="280">
                        <xAxis>
                            <CategoryAxis/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis/>
                        </yAxis>
                    </LineChart>
                </VBox>

                <VBox spacing="8" prefWidth="360">
                    <Label text="Status Breakdown" styleClass="chart-title"/>
                    <PieChart fx:id="statusChart" prefHeight="260"/>
                </VBox>
            </HBox>

            <TableView fx:id="attendanceTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colEmp" text="Employee" prefWidth="200"/>
                    <TableColumn fx:id="colProject" text="Project" prefWidth="180"/>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="120"/>
                    <TableColumn fx:id="colCheckIn" text="Check In" prefWidth="120"/>
                    <TableColumn fx:id="colCheckOut" text="Check Out" prefWidth="120"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
                    <TableColumn fx:id="colOT" text="Overtime Hours" prefWidth="140"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
